# Copy to supabase/functions/.env for local development (git-ignored).
# Production: npx supabase secrets set GEMINI_API_KEY=... GEMINI_MODEL=...
# Without GEMINI_API_KEY the function uses the deterministic fallback planner.
# Changes take effect after restarting the local stack (npx supabase stop / start).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: models tried in order when the main one is overloaded (comma-separated).
# Default: gemini-3.7-flash,gemini-3.5-flash,gemini-flash-latest. Empty = no backups.
# GEMINI_FALLBACK_MODELS=
