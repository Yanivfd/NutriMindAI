  "instructions_he": [
    "פורסים את חזה העוף לרצועות ומתבלים בפפריקה ומלח.",
    "צולים במחבת עם שמן זית 6-8 דקות עד שהעוף מוכן.",
    "מערבבים טחינה עם מיץ לימון ומעט מים לרוטב חלק.",
    "ממלאים את הפיתה בעוף, ירקות קצוצים, חסה ורוטב טחינה."
  ],
  "instructions_en": [
    "Slice the chicken breast into strips and season with paprika and salt.",
    "Sear in a pan with the olive oil for 6-8 minutes until cooked through.",
    "Whisk the tahini with lemon juice and a little water into a smooth sauce.",
    "Fill the pita with the chicken, chopped vegetables, lettuce and tahini sauce."
