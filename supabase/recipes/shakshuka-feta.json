  "instructions_he": [
    "מחממים שמן זית במחבת ומטגנים בצל, שום ופלפל חתוכים כ-5 דקות.",
    "מוסיפים את העגבניות המרוסקות, מתבלים במלח ופפריקה ומבשלים 5 דקות.",
    "יוצרים 3 גומות, שוברים לתוכן את הביצים, מכסים ומבשלים עד שהחלבון מתייצב.",
    "מפזרים פטה מפוררת ומגישים עם הפיתה."
  ],
  "instructions_en": [
    "Heat the olive oil in a pan and saute the chopped onion, garlic and pepper for about 5 minutes.",
    "Add the crushed tomatoes, season with salt and paprika and simmer for 5 minutes.",
    "Make 3 wells, crack in the eggs, cover and cook until the whites are set.",
    "Top with crumbled feta and serve with the pita."
  ],
