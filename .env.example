# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app, so only
# public values belong here (never the Supabase secret/service role key or Gemini key).

# Local Supabase: run `npx supabase status` for the URL and publishable key.
# Android emulator reaches the host at 10.0.2.2; a physical phone needs your PC's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AdMob ad unit IDs. Defaults are Google's official Android test units; replace for release.
EXPO_PUBLIC_ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
EXPO_PUBLIC_ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917

# EAS cloud builds do not read this .env file. Set the same EXPO_PUBLIC_* values with:
#   npx eas-cli@latest secret:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value ... --type string
#   (and BANNER / INTERSTITIAL / REWARDED the same way)
# Or Project → Environment variables on https://expo.dev
